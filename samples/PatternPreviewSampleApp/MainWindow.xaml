<Window x:Class="PatternPreviewSampleApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:FillPatternPreview.Controls;assembly=FillPatternPreview"
        mc:Ignorable="d"
        Title="Pattern Preview Sample" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Margin="8">
            <TextBlock Text="Raw .pat Text:" FontWeight="Bold" />
            <TextBox x:Name="PatTextBox" AcceptsReturn="True" Height="160" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0"/>
            <TextBlock Text="Pattern Name (optional):" Margin="0,8,0,0" />
            <TextBox x:Name="PatternNameBox" />
            <CheckBox Content="Tile pattern" Margin="0,8,0,0" IsChecked="{Binding TilePattern, ElementName=Preview, Mode=TwoWay}" />
            <CheckBox Content="Highlight first tile" Margin="0,8,0,0" IsChecked="{Binding HighlightFirstTile, ElementName=Preview, Mode=TwoWay}" />
            <CheckBox Content="Interactive" Margin="0,8,0,0" IsChecked="{Binding IsInteractive, ElementName=Preview, Mode=TwoWay}" />
            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="Gray"
                       Text="Wheel: zoom at cursor. Drag: pan. Double-click or Ctrl+0: reset. Click the preview, then +/- to zoom and arrows to pan." />
            <TextBlock x:Name="ViewStatus" Margin="0,4,0,0" />
            <Button Content="Apply" Click="OnApply" Margin="0,8,0,0" />
        </StackPanel>
        <Border Grid.Column="1" Margin="8" BorderBrush="Gray" BorderThickness="1">
            <controls:FillPatternPreview x:Name="Preview" PatRawText="" PatPatternName="" IsInteractive="True" InteractionChanged="OnInteractionChanged" />
        </Border>
    </Grid>
</Window>